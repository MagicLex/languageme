#!/usr/bin/env python3
"""languageme — a progressive language-immersion drip for Claude Code.

Instead of a hard "respond in X" switch, it injects a *blend* preprompt
("render ~N% of your prose in Swedish, the rest in your usual language"), then
monitors the transcript to measure the real ratio produced and ramps N up on
evidence (mastery-gated), not on a calendar.

Standalone: one file, stdlib only, no pip installs. Wire it into Claude Code
with `languageme install`: a SessionStart hook that injects the preprompt, a
Stop hook that measures the finished turn, and a statusline segment that
augments whatever statusline you already have (never replaces it).

State lives in $LANGUAGEME_HOME (default ~/.languageme); the code is portable.
"""

import json
import os
import re
import select
import subprocess
import sys
from contextlib import contextmanager
from pathlib import Path

try:
    import fcntl
except ImportError:  # non-POSIX: locking degrades to a best-effort no-op
    fcntl = None

# ---------------------------------------------------------------------------
# Paths / state
# ---------------------------------------------------------------------------

HOME = Path(os.environ.get("LANGUAGEME_HOME", str(Path.home() / ".languageme")))
STATE_PATH = HOME / "state.json"
SELF_PATH = os.path.abspath(__file__)

LANG_NAMES = {
    "sv": "Swedish",
    "lv": "Latvian",
    "de": "German",
    "es": "Spanish",
    "it": "Italian",
    "pt": "Portuguese",
    "nl": "Dutch",
    "no": "Norwegian",
    "da": "Danish",
}

DEFAULTS = {
    "target": "sv",
    "target_name": "Swedish",
    "pct": 10,          # current blend target, integer percent
    "goal": 40,         # ceiling to ramp toward
    "floor": 5,         # never ramp below this
    "step": 3,          # ramp increment / decrement
    "help": "auto",     # auto | on | off
    "ramp": "mastery",  # mastery | calendar | manual
    "streak": 0,        # consecutive ready sessions (mastery mode)
    "history": [],      # list of session measurements, most recent last
    "sessions": {},     # session_id -> last processed transcript line index
    "inner_statusline": None,  # the statusline command we wrap (None = we added a fresh one)
}

HISTORY_CAP = 60
SESSIONS_CAP = 25


def load_state():
    if STATE_PATH.exists():
        try:
            s = json.loads(STATE_PATH.read_text())
        except Exception:
            s = {}
    else:
        s = {}
    merged = dict(DEFAULTS)
    merged.update(s)
    # target_name always tracks target
    merged["target_name"] = LANG_NAMES.get(merged["target"], merged["target"])
    return merged


@contextmanager
def state_lock():
    """Serialize read-modify-write of state across concurrent sessions, so two
    Stop hooks firing at once can't clobber each other's append. Best-effort:
    a no-op where fcntl is unavailable (non-POSIX)."""
    HOME.mkdir(parents=True, exist_ok=True)
    fh = open(HOME / ".lock", "w")
    try:
        if fcntl is not None:
            fcntl.flock(fh, fcntl.LOCK_EX)
        yield
    finally:
        if fcntl is not None:
            try:
                fcntl.flock(fh, fcntl.LOCK_UN)
            except Exception:
                pass
        fh.close()


def save_state(s):
    HOME.mkdir(parents=True, exist_ok=True)
    s["history"] = s.get("history", [])[-HISTORY_CAP:]
    # prune old session cursors
    sess = s.get("sessions", {})
    if len(sess) > SESSIONS_CAP:
        # keep the most recently touched by insertion order
        keys = list(sess.keys())[-SESSIONS_CAP:]
        s["sessions"] = {k: sess[k] for k in keys}
    tmp = STATE_PATH.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(s, ensure_ascii=False, indent=2))
    tmp.replace(STATE_PATH)


# ---------------------------------------------------------------------------
# Language classification (heuristic, char-weighted, stdlib only)
#
# FR / EN / SV are lexically well separated, so a curated stopword hit-rate per
# sentence plus a diacritic signal classifies prose reliably without any ML
# dependency. If accuracy ever falls short, swap classify_prose() for a call to
# `lingua`; the rest of the tool is agnostic to how the ratio is produced.
# ---------------------------------------------------------------------------

SV_STOP = set("""
