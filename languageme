USAGE = """languageme — progressive language-immersion drip for Claude Code

  languageme init <lang>        seed a target language (default sv / Swedish)
  languageme status             show target, blend %, recent measurements, ramp
  languageme statusline         compact segment for a statusline (e.g. "sv 12%↑")
      --wrap                      run the wrapped statusline, append our segment

  languageme hook               [SessionStart] print the preprompt to inject
  languageme monitor            [Stop] measure the finished turn, ramp the %
      --session <path>            measure a specific transcript (manual)
      --full                      re-measure the whole transcript, not just new lines
      --quiet                     suppress the stderr report

  languageme set pct|goal|floor|step <n>   tune the numbers
  languageme bump [+n]          nudge the blend now (default = one step)
  languageme goal <n>           set the ceiling to ramp toward
  languageme help on|off|auto   inline-gloss policy
  languageme ramp mastery|calendar|manual   how the % grows
  languageme lang [<code>]      show / switch target language

  languageme install            wire the hooks + statusline into settings.json
  languageme uninstall          remove them, restore the original statusline

State: {state}
""".format(state=STATE_PATH)

DISPATCH = {
    "init": cmd_init,
    "status": cmd_status,
    "statusline": cmd_statusline,
    "hook": cmd_hook,
    "monitor": cmd_monitor,
    "set": cmd_set,
    "bump": cmd_bump,
    "goal": cmd_goal,
    "help": cmd_help_mode,
    "ramp": cmd_ramp,
    "lang": cmd_lang,
    "install": cmd_install,
    "uninstall": cmd_uninstall,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help") and len(argv) == 1:
        sys.stdout.write(USAGE)
        return 0
    cmd, rest = argv[0], argv[1:]
    fn = DISPATCH.get(cmd)
    if not fn:
        sys.stderr.write(f"languageme: unknown command '{cmd}'\n\n")
        sys.stdout.write(USAGE)
        return 1
    return fn(rest)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
